PROJECT_NAME           = reef_perf
OUTPUT_DIRECTORY       = build/doxygen
INPUT                  = src/csrc/include
FILE_PATTERNS          = *.hpp
RECURSIVE              = YES
EXTRACT_ALL            = NO
# Private members are documented too: the build fails if one is missing.
EXTRACT_PRIVATE        = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
# WARN_IF_INCOMPLETE_DOC (used by inference-engine) needs Doxygen >= 1.9.5;
# the image has Ubuntu 22.04's 1.9.1. WARN_NO_PARAMDOC covers the same ground.
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
# Sparta's PARAMETER(type, name, default, doc) macro declares a parameter
# member. Expand it so Doxygen sees a plain member declaration.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = "PARAMETER(type,name,def,doc)=type name;"
