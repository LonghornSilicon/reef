PROJECT_NAME           = reef_perf
OUTPUT_DIRECTORY       = build/doxygen
INPUT                  = src
EXCLUDE                = src/reef_perf
FILE_PATTERNS          = *.h
RECURSIVE              = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
# Parameters are documented by the description string in PARAMETER(...).
EXCLUDE_SYMBOLS        = *ParameterSet
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
# LLVM style documents parameters in prose (\p Name), not one \param each.
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
# Expand Sparta's PARAMETER(type, name, default, doc) so Doxygen sees a member.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = "PARAMETER(type,name,def,doc)=type name;"
