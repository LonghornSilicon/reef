+// After each weight chunk: steps_total steps spread over window chunks, at
+// most a few at once, and only for heads that have q, k and v.
+void attn_poll() {
+    if (job.remaining == 0) {
+        return;
+    }
+    job.credit += job.steps_total;
+    if (job.credit > 4 * job.window) {
+        job.credit = 4 * job.window;
+    }
