+        (job.tail_block - job.first_block + kKvChunk) / kKvChunk;
+    job.steps_total = stories * kNumHeads * per_head;
+    job.remaining = job.steps_total;
+    job.window = window_chunks;
+    job.credit = 0;
+    job.heads_ready = 0;
+    job.buf = 0;
+    job.cur = job.next = Pos{0, 0, 0, job.first_block};
