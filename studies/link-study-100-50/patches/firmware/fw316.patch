+
+void attn_begin(uint32_t layer, uint32_t start_pos, uint32_t stories,
+                uint32_t window_chunks) {
+    const bool local = (layer & 1) != 0;
+    job.layer = layer;
+    job.start_pos = start_pos;
+    job.stories = stories;
+    job.tail_col = start_pos & 15;
+    job.tail_block = start_pos >> 4;
