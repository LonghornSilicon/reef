+        uint8_t* value_block =
+            dtcm.shared.attn.kv_buf[buf][1] + (block - p.block) * kKvBlock;
+        if (block == job.tail_block) { // insert the new token at tail_col
+            for (uint32_t j = 0; j < kHeadDim; ++j) {
+                __riscv_vse8_v_i8m1(
+                    reinterpret_cast<int8_t*>(key_block) + j * 16 +
+                        job.tail_col,
+                    __riscv_vle8_v_i8m1(dtcm.shared.attn.key +
+                                            (head * kHeadDim + j) *
+                                                kBlockTokens +
+                                            col,
+                                        1),
+                    1);
