+// ---- Decode attention between weight chunks (step 3.16) -------------------
+// Steps of up to kKvChunk blocks, in the order: head pair, story, head of the
+// pair, block. A head pair can run once qkv has produced its q, k and v
+// (attn_unlock). The KV reads of the next step are always in flight; they do
+// not depend on q. Story s uses column s and its own KV cache.
+namespace {
+struct Pos {
+    uint32_t pair, story, half, block;
+};
+struct DecodeJob {
+    uint32_t layer, start_pos, stories, first_block, tail_block, tail_col;
+    uint32_t heads_ready, credit, window, steps_total, remaining, buf;
+    uint32_t ready_job[2]; // DMA number of each buffer's V read
+    Pos cur, next;         // step to compute next; step to read next
+    bool next_valid;
+    uint32_t tail_job;     // DMA number of the tail block's V read (3.20)
+};
+DecodeJob job;
+
+uint32_t head_of(const Pos& p) { return 2 * p.pair + p.half; }
+
+void advance(Pos& p) {
+    p.block += kKvChunk;
+    if (p.block > job.tail_block) {
+        p.block = job.first_block;
+        if (++p.half == 2) {
+            p.half = 0;
+            if (++p.story == job.stories) {
+                p.story = 0;
+                ++p.pair;
+            }
+        }
+    }
+}
+
+[[maybe_unused]] uint32_t cache_offset(const Pos& p, uint32_t block) {
+    return p.story * kStoryCacheBytes +
+           job.layer * kNumHeads * kKvBlocks * kKvBlock +
+           (head_of(p) * kKvBlocks + block) * kKvBlock;
+}
+
+#ifdef E2E_STREAM_KV
+// Step 3.20 assumption: in the KV cache each (head, block) is K then V (V by
+// 16-dim halves), so one transfer streams a step's blocks in the order the
+// MACs use them. The tail block (the new token goes in) comes to the DTCM.
+constexpr uint32_t kKvStream = 0x51000000;
+uint32_t pair_offset(const Pos& p, uint32_t block) {
+    return p.story * kStoryCacheBytes +
+           ((job.layer * kNumHeads + head_of(p)) * kKvBlocks + block) * 2 *
+               kKvBlock;
+}
+
+void issue_next(uint32_t) {
+    const Pos& p = job.next;
+    uint32_t end = p.block + kKvChunk;
+    if (end > job.tail_block + 1) {
+        end = job.tail_block + 1;
+    }
+    const bool has_tail = end == job.tail_block + 1;
+    const uint32_t streamed = end - p.block - (has_tail ? 1 : 0);
+    if (streamed) {
+        dma(kKeyCache + pair_offset(p, p.block), kKvStream,
+            streamed * 2 * kKvBlock);
+    }
+    if (has_tail) {
+        const uint32_t tail = kKeyCache + pair_offset(p, job.tail_block);
+        dma(tail, addr(dtcm.shared.attn.kv_buf[0][0]), kKvBlock);
+        job.tail_job =
+            dma(tail + kKvBlock, addr(dtcm.shared.attn.kv_buf[0][1]), kKvBlock);
+    }
+    advance(job.next);
+    job.next_valid = job.next.pair < kNumHeads / 2;
+}
+#else
+void issue_next(uint32_t buf) {
+    const Pos& p = job.next;
+    const uint32_t count = (job.tail_block + 1 - p.block) < kKvChunk
+                               ? job.tail_block + 1 - p.block
+                               : kKvChunk;
+    const uint32_t offset = cache_offset(p, p.block);
+    dma(kKeyCache + offset, addr(dtcm.shared.attn.kv_buf[buf][0]),
+        count * kKvBlock);
+    job.ready_job[buf] = dma(kValueCache + offset,
+                             addr(dtcm.shared.attn.kv_buf[buf][1]),
+                             count * kKvBlock);
+    advance(job.next);
+    job.next_valid = job.next.pair < kNumHeads / 2;
+}
+#endif
+
+void step() {
+    const Pos p = job.cur;
+    const uint32_t head = head_of(p);
+    const uint32_t col = p.story;
+    const uint32_t buf = job.buf;
+#ifndef E2E_STREAM_KV
+    dma_wait_job(job.ready_job[buf]);
+#endif
+    if (job.next_valid) {
+        issue_next(buf ^ 1);
+    }
+    DecodeState& state = dtcm.dec;
+    if (p.block == job.first_block) {
+        state.row_max = kNegInf;
+        state.row_sum = 0;
+        for (uint32_t dim0 = 0; dim0 < kHeadDim; dim0 += 16) {
+            __riscv_vse32_v_i32m4(state.out_acc + dim0, splat(0), 16);
+        }
