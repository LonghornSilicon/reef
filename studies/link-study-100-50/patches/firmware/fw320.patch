+                                        head * kHeadDim,
+                                    kHeadDim),
+                kHeadDim);
+        }
+        attend_row(head, block, key_block, value_block, job.start_pos, local,
+                   col);
+        if (block == job.tail_block) { // write the newest block back
+#ifdef E2E_STREAM_KV
+            const uint32_t tail = kKeyCache + pair_offset(p, block);
+            dma(addr(key_block), tail, kKvBlock);
+            dma(addr(value_block), tail + kKvBlock, kKvBlock);
+#else
+            const uint32_t offset = cache_offset(p, block);
+            dma(addr(key_block), kKeyCache + offset, kKvBlock);
+            dma(addr(value_block), kValueCache + offset, kKvBlock);
+#endif
+        }
+    }
+    if (p.block + kKvChunk > job.tail_block) { // head done: into q's place
+        const int32_t recip = static_cast<int32_t>(
+            (1U << 20) / static_cast<uint32_t>(state.row_sum));
+        for (uint32_t dim0 = 0; dim0 < kHeadDim; dim0 += 16) {
+            vint32m4_t out = __riscv_vsub_vx_i32m4(
+                __riscv_vle32_v_i32m4(state.out_acc + dim0, 16),
+                state.row_sum << 7, 16);
+            out = __riscv_vsra_vx_i32m4(__riscv_vmul_vx_i32m4(out, recip, 16),
+                                        20, 16);
+            __riscv_vsse8_v_i8m1(dtcm.shared.attn.query +
+                                     (head * kHeadDim + dim0) * kBlockTokens +
+                                     col,
+                                 kBlockTokens, to_i8(out),
+                                 kHeadDim - dim0 < 16 ? kHeadDim - dim0 : 16);
+        }
+    }
+    job.buf ^= 1;
+    advance(job.cur);
+    --job.remaining;
+}
+} // namespace
+
+void attn_begin(uint32_t layer, uint32_t start_pos, uint32_t stories,
+                uint32_t window_chunks) {
+    const bool local = (layer & 1) != 0;
+    job.layer = layer;
+    job.start_pos = start_pos;
+    job.stories = stories;
+    job.tail_col = start_pos & 15;
+    job.tail_block = start_pos >> 4;
+    job.first_block = (local && start_pos + 1 > kLocalWindow)
+                          ? (start_pos + 1 - kLocalWindow) >> 4
+                          : 0;
+    const uint32_t per_head =
+        (job.tail_block - job.first_block + kKvChunk) / kKvChunk;
+    job.steps_total = stories * kNumHeads * per_head;
+    job.remaining = job.steps_total;
+    job.window = window_chunks;
+    job.credit = 0;
+    job.heads_ready = 0;
+    job.buf = 0;
+    job.cur = job.next = Pos{0, 0, 0, job.first_block};
+    issue_next(0);
+#ifdef E2E_STREAM_KV
+    if (job.next_valid) {
+        issue_next(1); // two steps in flight: the stream needs no buffer
+    }
+#endif
+}
+
+void attn_unlock(uint32_t pair) { job.heads_ready = 2 * (pair + 1); }
+
+// After each weight chunk: steps_total steps spread over window chunks, at
+// most a few at once, and only for heads that have q, k and v.
+void attn_poll() {
+    if (job.remaining == 0) {
+        return;
+    }
+    job.credit += job.steps_total;
+    if (job.credit > 4 * job.window) {
+        job.credit = 4 * job.window;
+    }
+    while (job.credit >= job.window && job.remaining != 0 &&
+           head_of(job.cur) < job.heads_ready) {
+        step();
+        job.credit -= job.window;
+    }
+}
+
+void attn_drain() {
+    job.heads_ready = kNumHeads;
+    while (job.remaining != 0) {
+        step();
+    }
+    dma_wait(); // the last write-backs
+}
+
 } // namespace npu
