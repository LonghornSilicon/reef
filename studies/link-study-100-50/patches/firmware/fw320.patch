+    for (uint32_t block = p.block;
+         block <= job.tail_block && block < p.block + kKvChunk; ++block) {
+#ifdef E2E_STREAM_KV
+        if (block != job.tail_block) {
+            attend_row(head, block, nullptr, nullptr, job.start_pos, local,
+                       col, true);
+            continue;
+        }
+        uint8_t* key_block = dtcm.shared.attn.kv_buf[0][0];
+        uint8_t* value_block = dtcm.shared.attn.kv_buf[0][1];
+        dma_wait_job(job.tail_job);
+#else
+        uint8_t* key_block =
+            dtcm.shared.attn.kv_buf[buf][0] + (block - p.block) * kKvBlock;
+        uint8_t* value_block =
+            dtcm.shared.attn.kv_buf[buf][1] + (block - p.block) * kKvBlock;
+#endif
+        if (block == job.tail_block) { // insert the new token at tail_col
+            for (uint32_t j = 0; j < kHeadDim; ++j) {
