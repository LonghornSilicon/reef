+E2E_INLINE void config_int8(uint32_t rows) { tile_rows = rows; }
+E2E_INLINE void vtzero(bool all = false) {
+    const vint32m4_t zero = __riscv_vmv_v_x_i32m4(0, 16);
+    for (uint32_t acc = 0; acc < (all ? 4U : 1U); ++acc) {
+        for (uint32_t row = 0; row < kBlockTokens; ++row) {
+            __riscv_vse32_v_i32m4(tile_acc[acc][row], zero, 16);
