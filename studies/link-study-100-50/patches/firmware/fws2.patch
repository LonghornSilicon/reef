+namespace npu {
+
+constexpr uint32_t kChunkRows = 32; // weight rows (of 64 B) per DMA chunk: 2 KB
+// Rows per linear() chunk. With the weight stream, the chunk is not held in
+// the DTCM, so it can be larger (step 3.18).
+#if defined(E2E_STREAM_B) && defined(E2E_STREAM_ROWS)
+constexpr uint32_t kLinRows = E2E_STREAM_ROWS;
+#else
+constexpr uint32_t kLinRows = kChunkRows;
