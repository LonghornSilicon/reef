+// linear() calls attn_poll() after each chunk; attn_unlock(group) says the
+// heads of qkv output group `group` have q, k and v; attn_drain() finishes. The output
+// goes into dtcm.shared.attn.query.
+void attn_begin(uint32_t layer, uint32_t start_pos, uint32_t stories,
+                uint32_t window_chunks);
+void attn_poll();
+void attn_unlock(uint32_t pair);
+void attn_drain();
+// attention.cc: one layer's attention, Q/K/V staged in dtcm.shared.attn,
+// output into dtcm.normed; reads and extends that layer's KV cache.
+// With tokens == 1, col is the token's column and story selects its KV cache.
+void attention(uint32_t layer, uint32_t tokens, uint32_t start_pos,
+               uint32_t col = 0, uint32_t story = 0);
+// lm_head.cc: tied lm_head on column token_col of dtcm.normed; argmax token.
+uint32_t lm_head(uint32_t token_col);
+// lm_head on columns 0..tokens-1; one argmax token per column into next[].
+void lm_head_rows(uint32_t tokens, uint32_t* next);
+
+} // namespace npu
