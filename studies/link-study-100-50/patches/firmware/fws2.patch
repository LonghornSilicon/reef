+// ---- Decode attention between weight chunks (step 3.16) -------------------
+// Steps of up to kKvChunk blocks, in the order: head pair, story, head of the
+// pair, block. A head pair can run once qkv has produced its q, k and v
+// (attn_unlock). The KV reads of the next step are always in flight; they do
+// not depend on q. Story s uses column s and its own KV cache.
+namespace {
+struct Pos {
+    uint32_t pair, story, half, block;
+};
+struct DecodeJob {
+    uint32_t layer, start_pos, stories, first_block, tail_block, tail_col;
+    uint32_t heads_ready, credit, window, steps_total, remaining, buf;
+    uint32_t ready_job[2]; // DMA number of each buffer's V read
+    Pos cur, next;         // step to compute next; step to read next
+    bool next_valid;
+    uint32_t tail_job;     // DMA number of the tail block's V read (3.20)
+};
+DecodeJob job;
+
+uint32_t head_of(const Pos& p) { return 2 * p.pair + p.half; }
+
+void advance(Pos& p) {
+    p.block += kKvChunk;
+    if (p.block > job.tail_block) {
+        p.block = job.first_block;
+        if (++p.half == 2) {
+            p.half = 0;
+            if (++p.story == job.stories) {
+                p.story = 0;
+                ++p.pair;
+            }
+        }
+    }
+}
+
+[[maybe_unused]] uint32_t cache_offset(const Pos& p, uint32_t block) {
+    return p.story * kStoryCacheBytes +
+           job.layer * kNumHeads * kKvBlocks * kKvBlock +
+           (head_of(p) * kKvBlocks + block) * kKvBlock;
+}
+
+#ifdef E2E_STREAM_KV
+// Step 3.20 assumption: in the KV cache each (head, block) is K then V (V by
+// 16-dim halves), so one transfer streams a step's blocks in the order the
+// MACs use them. The tail block (the new token goes in) comes to the DTCM.
+constexpr uint32_t kKvStream = 0x51000000;
+uint32_t pair_offset(const Pos& p, uint32_t block) {
+    return p.story * kStoryCacheBytes +
+           ((job.layer * kNumHeads + head_of(p)) * kKvBlocks + block) * 2 *
+               kKvBlock;
+}
+
+void issue_next(uint32_t) {
+    const Pos& p = job.next;
+    uint32_t end = p.block + kKvChunk;
+    if (end > job.tail_block + 1) {
+        end = job.tail_block + 1;
+    }
+    const bool has_tail = end == job.tail_block + 1;
+    const uint32_t streamed = end - p.block - (has_tail ? 1 : 0);
+    if (streamed) {
+        dma(kKeyCache + pair_offset(p, p.block), kKvStream,
+            streamed * 2 * kKvBlock);
+    }
+    if (has_tail) {
+        const uint32_t tail = kKeyCache + pair_offset(p, job.tail_block);
+        dma(tail, addr(dtcm.shared.attn.kv_buf[0][0]), kKvBlock);
+        job.tail_job =
+            dma(tail + kKvBlock, addr(dtcm.shared.attn.kv_buf[0][1]), kKvBlock);
+    }
+    advance(job.next);
+    job.next_valid = job.next.pair < kNumHeads / 2;
+}
+#else
+void issue_next(uint32_t buf) {
+    const Pos& p = job.next;
+    const uint32_t count = (job.tail_block + 1 - p.block) < kKvChunk
+                               ? job.tail_block + 1 - p.block
+                               : kKvChunk;
+    const uint32_t offset = cache_offset(p, p.block);
+    dma(kKeyCache + offset, addr(dtcm.shared.attn.kv_buf[buf][0]),
+        count * kKvBlock);
+    job.ready_job[buf] = dma(kValueCache + offset,
+                             addr(dtcm.shared.attn.kv_buf[buf][1]),
+                             count * kKvBlock);
+    advance(job.next);
+    job.next_valid = job.next.pair < kNumHeads / 2;
+}
+#endif
+
+void step() {
+    const Pos p = job.cur;
+    const uint32_t head = head_of(p);
+    const uint32_t col = p.story;
+    const uint32_t buf = job.buf;
+#ifndef E2E_STREAM_KV
+    dma_wait_job(job.ready_job[buf]);
+#endif
+    if (job.next_valid) {
+        issue_next(buf ^ 1);
+    }
+    DecodeState& state = dtcm.dec;
+    if (p.block == job.first_block) {
+        state.row_max = kNegInf;
+        state.row_sum = 0;
+        for (uint32_t dim0 = 0; dim0 < kHeadDim; dim0 += 16) {
+            __riscv_vse32_v_i32m4(state.out_acc + dim0, splat(0), 16);
+        }
+    }
+    const bool local = (job.layer & 1) != 0;
+    for (uint32_t block = p.block;
+         block <= job.tail_block && block < p.block + kKvChunk; ++block) {
+#ifdef E2E_STREAM_KV
+        if (block != job.tail_block) {
+            attend_row(head, block, nullptr, nullptr, job.start_pos, local,
+                       col, true);
+            continue;
+        }
+        uint8_t* key_block = dtcm.shared.attn.kv_buf[0][0];
+        uint8_t* value_block = dtcm.shared.attn.kv_buf[0][1];
+        dma_wait_job(job.tail_job);
+#else
+        uint8_t* key_block =
+            dtcm.shared.attn.kv_buf[buf][0] + (block - p.block) * kKvBlock;
+        uint8_t* value_block =
+            dtcm.shared.attn.kv_buf[buf][1] + (block - p.block) * kKvBlock;
+#endif
+        if (block == job.tail_block) { // insert the new token at tail_col
+            for (uint32_t j = 0; j < kHeadDim; ++j) {
+                __riscv_vse8_v_i8m1(
+                    reinterpret_cast<int8_t*>(key_block) + j * 16 +
+                        job.tail_col,
+                    __riscv_vle8_v_i8m1(dtcm.shared.attn.key +
+                                            (head * kHeadDim + j) *
+                                                kBlockTokens +
+                                            col,
+                                        1),
+                    1);
+            }
+            __riscv_vse8_v_u8m4(
+                value_block + job.tail_col * kHeadDim,
+                __riscv_vle8_v_u8m4(dtcm.shared.attn.value + col * kHidden +
+                                        head * kHeadDim,
+                                    kHeadDim),
+                kHeadDim);
+        }
+        attend_row(head, block, key_block, value_block, job.start_pos, local,
+                   col);
+        if (block == job.tail_block) { // write the newest block back
+#ifdef E2E_STREAM_KV
+            const uint32_t tail = kKeyCache + pair_offset(p, block);
+            dma(addr(key_block), tail, kKvBlock);
+            dma(addr(value_block), tail + kKvBlock, kKvBlock);
+#else
+            const uint32_t offset = cache_offset(p, block);
+            dma(addr(key_block), kKeyCache + offset, kKvBlock);
+            dma(addr(value_block), kValueCache + offset, kKvBlock);
+#endif
+        }
+    }
+    if (p.block + kKvChunk > job.tail_block) { // head done: into q's place
+        const int32_t recip = static_cast<int32_t>(
+            (1U << 20) / static_cast<uint32_t>(state.row_sum));
+        for (uint32_t dim0 = 0; dim0 < kHeadDim; dim0 += 16) {
+            vint32m4_t out = __riscv_vsub_vx_i32m4(
+                __riscv_vle32_v_i32m4(state.out_acc + dim0, 16),
+                state.row_sum << 7, 16);
+            out = __riscv_vsra_vx_i32m4(__riscv_vmul_vx_i32m4(out, recip, 16),
+                                        20, 16);
+            __riscv_vsse8_v_i8m1(dtcm.shared.attn.query +
+                                     (head * kHeadDim + dim0) * kBlockTokens +
+                                     col,
+                                 kBlockTokens, to_i8(out),
+                                 kHeadDim - dim0 < 16 ? kHeadDim - dim0 : 16);
+        }
+    }
+    job.buf ^= 1;
+    advance(job.cur);
+    --job.remaining;
+}
+} // namespace
+
+void attn_begin(uint32_t layer, uint32_t start_pos, uint32_t stories,
+                uint32_t window_chunks) {
+    const bool local = (layer & 1) != 0;
+    job.layer = layer;
+    job.start_pos = start_pos;
+    job.stories = stories;
+    job.tail_col = start_pos & 15;
+    job.tail_block = start_pos >> 4;
+    job.first_block = (local && start_pos + 1 > kLocalWindow)
+                          ? (start_pos + 1 - kLocalWindow) >> 4
+                          : 0;
+    const uint32_t per_head =
+        (job.tail_block - job.first_block + kKvChunk) / kKvChunk;
+    job.steps_total = stories * kNumHeads * per_head;
+    job.remaining = job.steps_total;
+    job.window = window_chunks;
+    job.credit = 0;
+    job.heads_ready = 0;
+    job.buf = 0;
+    // Field by field: a struct copy here pulls memcpy into the ITCM (S2).
+    job.cur.pair = job.cur.story = job.cur.half = 0;
+    job.next.pair = job.next.story = job.next.half = 0;
+    job.cur.block = job.next.block = job.first_block;
+    issue_next(0);
+#ifdef E2E_STREAM_KV
+    if (job.next_valid) {
+        issue_next(1); // two steps in flight: the stream needs no buffer
+    }
+#endif
+}
+
+// After qkv output group g (64 features) every head inside it has q, k and v:
+// 64 / kHeadDim heads per group (2 at 52M, 4 in the small model).
+void attn_unlock(uint32_t group) {
+    const uint32_t ready = (group + 1) * (64 / kHeadDim);
+    job.heads_ready = ready < kNumHeads ? ready : kNumHeads;
+}
+
+// After each weight chunk: steps_total steps spread over window chunks, at
+// most a few at once, and only for heads that have q, k and v.
+void attn_poll() {
+    if (job.remaining == 0) {
+        return;
+    }
+    job.credit += job.steps_total;
+    if (job.credit > 4 * job.window) {
+        job.credit = 4 * job.window;
+    }
+    while (job.credit >= job.window && job.remaining != 0 &&
+           head_of(job.cur) < job.heads_ready) {
+        step();
+        job.credit -= job.window;
+    }
+}
+
+void attn_drain() {
+    job.heads_ready = kNumHeads;
+    while (job.remaining != 0) {
+        step();
+    }
+    dma_wait(); // the last write-backs
+}
+
 } // namespace npu
