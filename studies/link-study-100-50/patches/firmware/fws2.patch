+    for (uint32_t i = 0; i < 256; ++i) {
+        dtcm.exp_table[i] = static_cast<uint8_t>(decay >> 16);
+        decay = (decay >> 16) * 61565U; // 65536 * exp(-1/16)
+        const auto value = static_cast<int8_t>(i);
+        dtcm.gelu_table[i] =
+            value > 0 ? value : static_cast<int8_t>(value >> 3);
+    }
