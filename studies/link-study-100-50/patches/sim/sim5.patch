+Cycle Dma::getFinish() const {
+  Cycle Finish = 0;
+  for (const std::vector<size_t> &Chain : Chains)
+    if (!Chain.empty())
+      Finish = std::max(Finish, Jobs[Chain.back()].Finish);
+  return Finish;
+}
+
+Cycle Dma::getFinishExceptNewest() const {
+  // The newest transfer's channel only: its transfers finish in order.
+  if (Jobs.empty())
+    return 0;
+  const size_t Newest = Jobs.size() - 1;
+  for (const std::vector<size_t> &Chain : Chains)
+    if (!Chain.empty() && Chain.back() == Newest)
+      return Chain.size() < 2 ? 0 : Jobs[Chain[Chain.size() - 2]].Finish;
+  return 0;
+}
+
+Cycle Dma::getFinishOn(const ExtMemModel *Link) const {
+  if (Chains.size() == 1)
+    return getFinish();
+  auto Found = std::find(ChainLinks.begin(), ChainLinks.end(), Link);
+  if (Found == ChainLinks.end())
+    return 0;
+  const std::vector<size_t> &Chain =
+      Chains[static_cast<size_t>(Found - ChainLinks.begin()) % Chains.size()];
+  return Chain.empty() ? 0 : Jobs[Chain.back()].Finish;
+}
+
+uint32_t Dma::getChannel() {
+  if (Chains.size() == 1 || !FindLink)
+    return 0;
+  // The link of the end outside the TCMs names the channel. A transfer
+  // between two TCMs uses the first channel.
+  for (Address End : {Src, Dst}) {
+    if (FindTcm(End))
+      continue;
+    const ExtMemModel *Link = FindLink(End);
+    auto Found = std::find(ChainLinks.begin(), ChainLinks.end(), Link);
+    if (Found == ChainLinks.end())
+      Found = ChainLinks.insert(ChainLinks.end(), Link);
+    return static_cast<uint32_t>(Found - ChainLinks.begin()) % Chains.size();
+  }
+  return 0;
 }
 
